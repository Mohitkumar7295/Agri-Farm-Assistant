# ==============================================================================
# 🌾 AgriFarmAssistant - Master Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Spring Boot 3.3 Backend Configuration (Railway / Render / Local)
# ------------------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# Supabase PostgreSQL 16 + pgvector
SPRING_DATASOURCE_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres
SPRING_DATASOURCE_USERNAME=postgres.<your-project-ref>
SPRING_DATASOURCE_PASSWORD=<your-supabase-db-password>

# Upstash Redis (Serverless: 30-min weather cache, OTP store, rate limiting)
SPRING_DATA_REDIS_URL=rediss://default:<password>@<endpoint>.upstash.io:6379

# Cryptographic JWT Settings (HMAC-SHA256, 30 days)
JWT_SECRET=b7e28f3a91c4d5e6f7a8b9c0d1e2f3a4b5c6d7e8f9a0b1c2d3e4f5a6b7c8d9e0
JWT_EXPIRATION_DAYS=30

# CORS Allowed Origins (Comma-separated for Vercel & localhost)
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://your-production-app.vercel.app

# ------------------------------------------------------------------------------
# 2. Artificial Intelligence Core (100% Java Spring AI + Google Gemini)
# ------------------------------------------------------------------------------
SPRING_AI_GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere

# ------------------------------------------------------------------------------
# 3. Email Sentinel & Zero-SMS OTP (Resend API)
# ------------------------------------------------------------------------------
RESEND_API_KEY=re_YourResendApiKeyHere
RESEND_FROM_EMAIL=onboarding@resend.dev

# Optional SMTP Fallback
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SPRING_MAIL_AUTH=true
SPRING_MAIL_STARTTLS=true

# ------------------------------------------------------------------------------
# 4. Media & Object Storage (Supabase Storage: agrifarm-media)
# ------------------------------------------------------------------------------
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_SERVICE_KEY=<your-supabase-service-role-key>
SUPABASE_STORAGE_BUCKET=agrifarm-media

# ------------------------------------------------------------------------------
# 5. Next.js 15 PWA Frontend (Vercel)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_DEFAULT_LOCALE=hi
