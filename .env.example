# ==============================================================================
# 🌾 AgriFarmAssistant - Master Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Spring Boot 3.3 Backend Configuration (Railway / Local)
# ------------------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# PostgreSQL 16 with pgvector extension
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/agrifarm_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres_secure_pass

# Redis 7 (30-minute weather cache & OTP store)
SPRING_DATA_REDIS_URL=redis://localhost:6379

# Cryptographic JWT Settings (HMAC-SHA256, 30 days)
JWT_SECRET=b7e28f3a91c4d5e6f7a8b9c0d1e2f3a4b5c6d7e8f9a0b1c2d3e4f5a6b7c8d9e0
JWT_EXPIRATION_DAYS=30

# CORS Allowed Origins (Comma-separated for Vercel & localhost)
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://your-production-app.vercel.app

# ------------------------------------------------------------------------------
# 2. Artificial Intelligence Core (Spring AI + Google Gemini)
# ------------------------------------------------------------------------------
# Google Gemini 1.5 Pro / Flash API Key
SPRING_AI_GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere

# ------------------------------------------------------------------------------
# 3. Email Sentinel & Zero-SMS OTP (Resend API)
# ------------------------------------------------------------------------------
# Resend API Key for instant 6-digit OTP delivery & 07:00 AM alerts
RESEND_API_KEY=re_YourResendApiKeyHere
EMAIL_FROM_ADDRESS=notifications@agrifarm.yourdomain.com

# ------------------------------------------------------------------------------
# 4. Object Storage (MinIO Local / Cloudflare R2 Free Tier)
# ------------------------------------------------------------------------------
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_BUCKET_NAME=agrifarm-storage
S3_ACCESS_KEY=your_cloudflare_r2_access_key
S3_SECRET_KEY=your_cloudflare_r2_secret_key
S3_REGION=auto

# ------------------------------------------------------------------------------
# 5. Next.js 15 PWA Frontend (Vercel)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_DEFAULT_LOCALE=hi
